{
  "name": "Commander Tracker",
  "short_name": "Commander",
  "description": "A Commander life tracker and game history for our playgroup",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0d12",
